{
  "name": "my-rag-js",
  "version": "1.0.0",
  "description": "Local RAG system \u2014 JS port",
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.env rag.js build",
    "stats": "node --env-file-if-exists=.env rag.js stats",
    "ask": "node --env-file-if-exists=.env rag.js ask",
    "serve": "node --env-file-if-exists=.env rag_web.js serve",
    "web-build": "node --env-file-if-exists=.env rag_web.js build",
    "build:seeds": "node seeds/build.mjs",
    "watch:seeds": "node seeds/build.mjs --watch"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "@xyflow/react": "12.11.2",
    "chromadb": "^1.10.5",
    "express": "^4.19.2",
    "ollama": "^0.5.9",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
